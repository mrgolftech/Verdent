# Local API server
VERDENT_LISTEN=:5084
VERDENT_API_KEY=change-me
VERDENT_ADMIN_USER=admin
VERDENT_ADMIN_PASSWORD=change-admin-password
VERDENT_REQUEST_TIMEOUT=5m
# Public browser callback origin when behind a reverse proxy.
# VERDENT_PUBLIC_BASE_URL=https://verdent.example.com

# Verdent protocol values: populate from the currently verified client/protocol.
VERDENT_APP_VERSION=
VERDENT_PROXY_BETA=
VERDENT_PROXY_SIGN=
# Recommended for current Verdent builds: captured Desktop request template.
# The file should contain the real encrypted "system" field and may also contain
# model_catalog_version/native_api from a current Desktop capture.
# VERDENT_SYSTEM_TEMPLATE_FILE=/root/verdent/config/template.json
# Current Desktop captures report native_api=false. Explicit env overrides template.
VERDENT_NATIVE_API=false
# Per-account pacing/retry defaults observed to avoid 20004 burst lanes.
VERDENT_MIN_REQUEST_INTERVAL=1.2s
VERDENT_RETRY_DELAYS=10s,25s,45s
# VERDENT_ENDPOINT=https://llm-proxy.verdent.ai/llm/stream
# VERDENT_CATALOG_ENDPOINT=https://llm-proxy.verdent.ai/config/model_list
# VERDENT_USER_AGENT=
# Desktop identity headers. Current Desktop captures send device_type=pc and
# os_type=windows; set VERDENT_OS_TYPE=windows to mirror them off-Windows hosts.
# VERDENT_OS_TYPE=windows
# VERDENT_DEVICE_TYPE=pc
# VERDENT_DEVICE_MODEL=
# Optional OAuth endpoints for testing/staging. Production defaults are built in.
# VERDENT_AUTH_BASE_URL=https://www.verdent.ai
# VERDENT_LOGIN_BASE_URL=https://login.verdent.ai

# Single-account bootstrap. For multiple accounts use VERDENT_ACCOUNTS_FILE.
VERDENT_ACCOUNT_ID=default
VERDENT_ACCOUNT_LABEL=
VERDENT_TOKEN=
VERDENT_DEVICE_ID=
VERDENT_TEAM_ID=0
# VERDENT_PROXY=http://user:pass@host:port

# Default managed store: data/accounts.json
# VERDENT_ACCOUNTS_FILE=/absolute/path/to/accounts.json
